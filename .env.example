
DATABASE_URL=postgresql+psycopg://pharos_user:pharos_password@localhost:5433/pharos
# Generate a unique secret of at least 32 bytes. Never use this placeholder.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REPORT_EXPIRY_HOURS=24
REPORTS_PER_HOUR_LIMIT=5
CLEAR_VOTES_THRESHOLD=3
FCM_CREDENTIALS_PATH=

# Public demo default; configure your own OSRM server for production.
OSRM_BASE_URL=https://router.project-osrm.org
